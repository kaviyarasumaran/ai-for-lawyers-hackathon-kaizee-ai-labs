MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=lawyer_app
APP_NAME=lawyer_api
APP_HOST=0.0.0.0
APP_PORT=8000
LLM_API_BASE_URL=http://localhost:1234/v1
LLM_API_KEY=
LLM_MODEL=google/gemma-4-e2b
LLM_TIMEOUT_SECONDS=60
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=case-documents
SUPABASE_TIMEOUT_SECONDS=120
POSTGRES_DSN=postgresql://postgres:c6425e0fefd2c236cc4e019b3269e524@<supabase-host>:5432/postgres
EMBEDDING_API_BASE_URL=http://localhost:1234/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-nomic-embed-text-v1.5
EMBEDDING_TIMEOUT_SECONDS=60
PIPELINE_POLL_SECONDS=2
PIPELINE_MAX_ATTEMPTS=5
POSTGRES_TENANT_ID=
JWT_SECRET=dev-insecure-secret-key-replace-in-production
CHAT_HISTORY_WINDOW=10
RETRIEVAL_TOP_K=5
RETRIEVAL_RELEVANCE_THRESHOLD=0.01
RATE_LIMIT_PER_MINUTE=60

# --- Audio Speech-to-Text Transcription Options ---
# Option A: Local Whisper CLI / Whisper.cpp (Metal GPU accelerated, 100% offline)
# WHISPER_CLI_PATH=/opt/homebrew/bin/whisper-cli
# WHISPER_MODEL_PATH=/opt/homebrew/share/whisper-cpp/models/ggml-base.bin
#
# Option B: Local Whisper Server (e.g., faster-whisper-server or whisper-server)
# TRANSCRIPTION_API_BASE_URL=http://localhost:8080/v1
# TRANSCRIPTION_API_KEY=
#
# Option C: Instant Cloud Whisper API (Groq - free 14,400 requests/day, or OpenAI)
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...
